{
  "variables": {
    "form-title": {
      "en": "DATA REQUEST FORM",
      "de": "DATENANFRAGEFORMULAR"
    },
    "page": {
      "en": "Page",
      "de": "Seite"
    },
    "of": {
      "en": "of",
      "de": "von"
    }
  },
  "filename_templates": {
    "pdf": "request-${project-code}-${timestamp}.pdf"
  },
  "template_file": "request",
  "template": "request",
  "display_name": {
    "en": "Data request",
    "de": "Datenanfrage"
  },
  "project_fields": [
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Your name and DKTK-affiliation",
        "de": "Ihr Name und Ihre DKTK-Zugehörigkeit"
      },
      "value": "${creator-name-with-affiliations}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Email address",
        "de": "E-Mail-Adresse"
      },
      "value": "${creator-email}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Request ID",
        "de": "Anfrage-ID"
      },
      "description": {
        "en": "Technical ID for the request",
        "de": "Technische ID der Anfrage"
      },
      "value": "${project-code}"
    },
    {
      "mandatory": true,
      "data_type": "DATE",
      "display_name": {
        "en": "Request application date",
        "de": "Antragsdatum der Anfrage"
      },
      "value": "${project-creation-date}"
    },
    {
      "label": "PROJECT_TYPE",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Type",
        "de": "Typ"
      },
      "value": "${project-types}"
    },
    {
      "label": "OUTPUT_FORMAT",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Output Format",
        "de": "Ausgabeformat"
      },
      "value": "${output-formats}"
    },
    {
      "label": "TEMPLATE_ID",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Template ID",
        "de": "Vorlagen-ID"
      },
      "value": "${template-ids}"
    },
    {
      "label": "ENVIRONMENT_VARIABLES",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Environment Variables",
        "de": "Umgebungsvariablen"
      },
      "value": "${environment-variables}"
    },
    {
      "label": "PROJECT_CONFIGURATION",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Configuration",
        "de": "Konfiguration"
      },
      "value": "${project-configuration}"
    },
    {
      "label": "SELECTED_COHORT",
      "form_title": "query",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Selected Cohort",
        "de": "Ausgewählte Kohorte"
      },
      "description": {
        "en": "This query was automatically imported from your Explorer session. Use \"Edit in Explorer\" to adjust your search criteria.",
        "de": "Diese Abfrage wurde automatisch aus Ihrer Explorer-Sitzung übernommen. Verwenden Sie \"Edit in Explorer\", um Ihre Suchkriterien anzupassen."
      },
      "value": "${selected-cohort}"
    },
    {
      "label": "QUERIED_SITES",
      "form_title": "query",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Selected Sites",
        "de": "Ausgewählte Standorte"
      },
      "description": {
        "en": "Sites identified via the Explorer as having samples or data matching your search criteria. (Note: The numbers are obfuscated and do not correspond to the exact results.)",
        "de": "Standorte, die über den Explorer als Standorte mit Proben oder Daten ermittelt wurden, die Ihren Suchkriterien entsprechen. (Hinweis: Die Zahlen sind verschleiert und entsprechen nicht den genauen Ergebnissen.)"
      },
      "value": "${queried-sites}"
    },
    {
      "label": "QUERY_FORMAT",
      "form_title": "query",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Query Format",
        "de": "Abfrageformat"
      },
      "value": "${query-format}"
    },
    {
      "label": "ADDITIONAL_FILTER_CRITERIA",
      "form_title": "query",
      "mandatory": false,
      "data_type": "LONG_STRING",
      "display_name": {
        "en": "Additional filter criteria",
        "de": "Zusätzliche Filterkriterien"
      },
      "description": {
        "en": "Please provide filter criteria that could not be selected in the Explorer, or further notes on the resources you want to request.",
        "de": "Bitte geben Sie Filterkriterien an, die im Explorer nicht ausgewählt werden konnten, oder weitere Hinweise zu den Ressourcen, die Sie anfordern möchten."
      },
      "value": "${additional-filter-criteria}"
    },
    {
      "label": "PROJECT_TITLE",
      "form_title": "project",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Request title",
        "de": "Titel der Anfrage"
      },
      "description": {
        "en": "Please give a short title for your request.",
        "de": "Bitte geben Sie einen kurzen Titel für Ihre Anfrage an."
      },
      "value": "${project-title}"
    },
    {
      "label": "PROJECT_DESCRIPTION",
      "form_title": "project",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Study Objective",
        "de": "Studienziel"
      },
      "description": {
        "en": "Short description of the request: What is the aim/objective of the request?",
        "de": "Kurze Beschreibung der Anfrage: Was ist das Ziel der Anfrage?"
      },
      "value": "${project-description}"
    },
    {
      "label": "DESCRIPTION_UPLOAD",
      "form_title": "project",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Request description document",
        "de": "Dokument mit der Beschreibung der Anfrage"
      },
      "value": "${description-upload-filename}"
    },
    {
      "label": "ETHICS_VOTE_FOR_ALL_SITES",
      "mandatory": false,
      "data_type": "STRING",
      "value": "${ethics-vote-for-all-sites-filename}"
    },
    {
      "label": "ETHICS_VOTE",
      "mandatory": false,
      "active": false,
      "data_type": "LONG_STRING",
      "display_name": {
        "en": "Ethics vote per site",
        "de": "Ethikvotum pro Standort"
      },
      "description": {
        "en": "Per-site ethics vote status, where a request may need one per queried site rather than a single vote for all sites.",
        "de": "Status des Ethikvotums pro Standort, wenn eine Anfrage statt eines einzigen Votums für alle Standorte eines pro abgefragtem Standort benötigt."
      },
      "value": "${ethics-votes-per-site}"
    }
  ]
}
