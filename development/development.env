# Lets the feasibility table be tested locally without Beam/Focus: each
# {{DATA_TYPE}} placeholder (see de.samply.form.DataType) is replaced with an
# independently random value of that type. Not ${...} (this file's own
# ${ROOT_DIRECTORY} substitution above would consume it first) and not #{...}
# (a bare # is a comment marker in some .env parsers, even mid-line).
TEST_FEASIBILITY_RESULT=[{"label": "Patients", "value": {{INTEGER}}}, {"label": "Samples", "value": {{INTEGER}}}]
TOKEN_MANAGER_URL=http://localhost:3030
