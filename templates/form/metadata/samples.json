{
  "variables": {
    "page": {
      "en": "Page",
      "de": "Seite"
    },
    "of": {
      "en": "of",
      "de": "von"
    }
  },
  "filename_templates": {
    "pdf": "samples-${project-code}-${timestamp}.pdf"
  },
  "form_titles": [
    "sample_data"
  ],
  "template": "samples",
  "display_name": {
    "en": "Samples"
  },
  "project_fields": [
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Your Name and DKTK-Affiliation"
      },
      "value": "${creator-name} (${creator-affiliations})"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project Title"
      },
      "description": {
        "en": "Please give a short title for your project."
      },
      "value": "${project-title}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Study Objective"
      },
      "description": {
        "en": "Please describe in very few words what your project is about. What is the objective/aim of your project? You can also attach a respective document."
      },
      "value": "${project-description}"
    }
  ]
}