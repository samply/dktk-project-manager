{
  "variables": {
    "form-title": {
      "en": "DATA REQUEST FORM",
      "de": "DATENANFRAGEFORMULAR"
    },
    "page": {
      "en": "Page",
      "de": "Seite"
    },
    "of": {
      "en": "of",
      "de": "von"
    }
  },
  "filename_templates": {
    "pdf": "cohort-${project-code}-${timestamp}.pdf"
  },
  "template_file": "request",
  "form_titles": [
    "project",
    "cohort"
  ],
  "template": "cohort",
  "display_name": {
    "en": "Data request"
  },
  "project_fields": [
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Your name and DKTK-affiliation"
      },
      "value": "${creator-name} (${creator-affiliations})"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Email address"
      },
      "value": "${creator-email}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project ID"
      },
      "description": {
        "en": "Technical ID for the project"
      },
      "value": "${project-code}"
    },
    {
      "mandatory": true,
      "data_type": "DATE",
      "display_name": {
        "en": "Project application date"
      },
      "value": "${project-creation-date}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Project title"
      },
      "description": {
        "en": "Please give a short title for your project"
      },
      "value": "${project-title}"
    },
    {
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Study Objective"
      },
      "description": {
        "en": "Short description of the project: What is the aim/objective of the project?"
      },
      "value": "${project-description}"
    }
  ]
}