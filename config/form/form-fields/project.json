    {
      "label": "principal-investigator",
      "min_instances": 1,
      "multiple": false,
      "display_name": {
        "en": "Principal Investigator (Applicant)",
        "de": "Hauptverantwortlicher (Antragsteller)"
      },
      "description": {
        "en": "The applicant serves as the primary point of contact.",
        "de": "Der Antragsteller dient als primärer Ansprechpartner."
      }
    },
    {
      "label": "collaborators",
      "multiple": true,
      "display_name": {
        "en": "Collaborator",
        "de": "Kooperationspartner"
      },
      "description": {
        "en": "If applicable, please provide the names, affiliations, and email addresses of your collaborators. All fields within a started entry are required.",
        "de": "Falls zutreffend, geben Sie bitte die Namen, Zugehörigkeiten und E-Mail-Adressen Ihrer Kooperationspartner an. Alle Felder innerhalb eines begonnenen Eintrags sind erforderlich."
      }
    }
  ],
