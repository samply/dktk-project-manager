          }
        }
      ]
    },
    {
      "label": "other_number_of_samples_per_subject",
      "mandatory": true,
      "data_type": "STRING",
      "display_name": {
        "en": "Number of samples per subject",
        "de": "Anzahl der Proben pro Person"
      },
      "description": {
        "en": "For example: 1 aliquot of 200 \u00b5l each.",
        "de": "Zum Beispiel: 1 Aliquot zu je 200 \u00b5l."
      },
      "block": "other"
    },
    {
      "label": "other_concentration_volume",
      "mandatory": true,
      "data_type": "INTEGER",
