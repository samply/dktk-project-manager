{
  "title": "samples",
  "display_name": {
    "en": "Biosample Request",
    "de": "Bioprobenanforderung"
  },
  "description": {
    "en": "Please specify the biosamples you require for your project.",
    "de": "Bitte geben Sie die für Ihr Projekt benötigten Bioproben an."
  },
  "blocks": [
    {
      "label": "liquid",
      "multiple": true,
      "display_name": {
        "en": "Liquid",
        "de": "Flüssigkeit"
      },
      "description": {
        "en": "Liquid biosamples.",
        "de": "Flüssige Bioproben."
      }
    },
    {
      "label": "tissue",
      "multiple": true,
      "display_name": {
        "en": "Tissue",
        "de": "Gewebe"
      },
      "description": {
        "en": "Tissue biosamples.",
        "de": "Gewebebioproben."
      }
    },
    {
      "label": "other",
      "multiple": true,
      "display_name": {
        "en": "Other sample type",
        "de": "Anderer Probentyp"
      }
    }
  ],
  "layouts": [
    {
      "rows": [
        {"fields": ["liquid_concentration_volume", "liquid_unit"]}
      ]
    },
    {
      "rows": [
        {"fields": ["other_concentration_volume", "other_unit"]}
      ]
    }
  ],
  "fields": [
    {
      "label": "minimum_patient_number",
      "mandatory": true,
      "data_type": "INTEGER",
      "display_name": {
        "en": "Minimum number of patients",
        "de": "Minimale Anzahl an Patienten"
      },
      "description": {
        "en": "Minimum number of patients from whom samples are required",
        "de": "Minimale Anzahl an Patienten, von denen Proben benötigt werden."
      }
    },
    {
      "label": "liquid_type",
      "mandatory": true,
      "data_type": "ENUM",
      "display_name": {
        "en": "Liquid type",
        "de": "Liquidtyp"
      },
      "description": {
        "en": "Liquid material type of the biosample.",
        "de": "Liquidmaterialtyp der Bioprobe."
      },
      "block": "liquid",
      "allowed_values": [
        {
          "label": "plasma",
          "display_name": {
            "en": "Plasma",
            "de": "Plasma"
          },
          "description": {
            "en": "A material entity which corresponds to the fluids component of blood, in which the blood cells are suspended.",
            "de": "Eine materielle Entität, die dem flüssigen Bestandteil des Blutes entspricht, in dem die Blutzellen suspendiert sind."
          }
        },
        {
          "label": "serum",
          "display_name": {
            "en": "Serum",
            "de": "Serum"
          },
          "description": {
            "en": "A material entity which derives from blood and corresponds to blood plasma without fibrinogen or the other clotting factors.",
            "de": "Eine materielle Entität, die aus Blut stammt und dem Blutplasma ohne Fibrinogen oder andere Gerinnungsfaktoren entspricht."
          }
        },
        {
          "label": "buffy_coat",
          "display_name": {
            "en": "Buffy coat",
            "de": "Buffy-Coat"
          },
          "description": {
            "en": "A processed specimen which is the output of a density gradient centrifugation of an anticoagulated blood specimen that contains most of the white blood cells and platelets.",
            "de": "Ein verarbeitetes Probenmaterial, das als Ergebnis einer Dichtegradientenzentrifugation von antikoaguliertem Blut gewonnen wird und hauptsächlich weiße Blutzellen und Blutplättchen enthält."
          }
        },
        {
          "label": "whole_blood",
          "display_name": {
            "en": "Whole blood",
            "de": "Vollblut"
          },
          "description": {
            "en": "A material entity derived from a portion of blood collected from an organism.",
            "de": "Eine materielle Entität, die aus einer einem Organismus entnommenen Blutportion stammt."
          }
        },
        {
          "label": "pbmc",
          "display_name": {
            "en": "Peripheral blood mononuclear cells (PBMC)",
            "de": "Mononukleäre Zellen des peripheren Blutes (PBMC)"
          },
          "description": {
            "en": "A leukocyte with a single non-segmented nucleus in the mature form found in the circulatory pool of blood.",
            "de": "Ein Leukozyt mit einem einzelnen, nicht segmentierten Kern in der reifen Form, der im zirkulierenden Blutpool gefunden wird."
          }
        },
        {
          "label": "bronchoalveolar_lavage",
          "display_name": {
            "en": "Bronchoalveolar lavage",
            "de": "Bronchoalveoläre Lavage"
          },
          "description": {
            "en": "Group of biomaterials present in the bronchial alveolar space of an organism collected through lavage including reagents, organisms, cells, and cellular secretions.",
            "de": "Gesamtheit der Biomaterialien im bronchoalveolären Raum, die durch Lavage gewonnen werden, einschließlich Reagenzien, Organismen, Zellen und zellulären Sekreten."
          }
        },
        {
          "label": "cerebrospinal_fluid",
          "display_name": {
            "en": "Cerebrospinal fluid",
            "de": "Zerebrospinalflüssigkeit"
          },
          "description": {
            "en": "A specimen that is derived from cerebrospinal fluid.",
            "de": "Eine Probe, die aus der Zerebrospinalflüssigkeit gewonnen wird."
          }
        },
        {
          "label": "bone_marrow_whole",
          "display_name": {
            "en": "Bone marrow, whole",
            "de": "Gesamtes Knochenmark"
          },
          "description": {
            "en": "A specimen that is derived from bone marrow.",
            "de": "Eine Probe, die aus Knochenmark gewonnen wird."
          }
        },
        {
          "label": "breast_milk",
          "display_name": {
            "en": "Breast milk",
            "de": "Muttermilch"
          },
          "description": {
            "en": "A specimen that is derived from milk.",
            "de": "Eine aus Milch gewonnene Probe."
          }
        },
        {
          "label": "bile",
          "display_name": {
            "en": "Bile",
            "de": "Galle"
          },
          "description": {
            "en": "A specimen that is derived from bile.",
            "de": "Eine Probe, die aus Galle gewonnen wird."
          }
        },
        {
          "label": "saliva",
          "display_name": {
            "en": "Saliva",
            "de": "Speichel"
          },
          "description": {
            "en": "A specimen that is derived from saliva.",
            "de": "Eine Probe, die aus Speichel gewonnen wurde."
          }
        },
        {
          "label": "faeces",
          "display_name": {
            "en": "Faeces",
            "de": "Fäzes"
          },
          "description": {
            "en": "A specimen that is derived from feces.",
            "de": "Eine aus Fäzes gewonnene Probe."
          }
        },
        {
          "label": "urine",
          "display_name": {
            "en": "Urine",
            "de": "Urin"
          },
          "description": {
            "en": "A portion of urine collected from an organism.",
            "de": "Eine einem Organismus entnommene Urinprobe."
          }
        },
        {
          "label": "other",
          "display_name": {
            "en": "Other",
            "de": "Sonstiges"
          },
          "description": {
            "en": "Any other type of material taken from a biological entity, e.g. amniotic fluid, cerebrospinal fluid (CSV), mitochondrial RNA.",
            "de": "Jede andere Art von Material, das von einer biologischen Entität entnommen wurde, z. B. Fruchtwasser, Liquor, mitochondriale RNA."
          }
        }
      ]
    },
    {
      "label": "liquid_number_of_samples_per_subject",
      "mandatory": true,
      "data_type": "INTEGER",
      "display_name": {
        "en": "Number of samples per subject",
        "de": "Anzahl der Proben pro Person"
      },
      "description": {
        "en": "For example: 1 aliquot/subject.",
        "de": "Zum Beispiel: 1 Aliquot/Person."
      },
      "block": "liquid"
    },
    {
      "label": "liquid_concentration_volume",
      "mandatory": true,
      "data_type": "INTEGER",
      "display_name": {
        "en": "Concentration / Volume",
        "de": "Konzentration / Volumen"
      },
      "block": "liquid",
      "properties": ["CSS_UNIT_VALUE"]
    },
    {
      "label": "liquid_unit",
      "mandatory": true,
      "data_type": "ENUM",
      "display_name": {
        "en": "Unit",
        "de": "Einheit"
      },
      "block": "liquid",
      "properties": ["CSS_UNIT"],
      "allowed_values": [
        {
          "label": "µl",
          "display_name": {
            "en": "µl",
            "de": "µl"
          },
          "description": {
            "en": "µl",
            "de": "µl"
          }
        },
        {
          "label": "ng/µl",
          "display_name": {
            "en": "ng/µl",
            "de": "ng/µl"
          },
          "description": {
            "en": "ng/µl",
            "de": "ng/µl"
          }
        },
        {
          "label": "µg/ml",
          "display_name": {
            "en": "µg/ml",
            "de": "µg/ml"
          },
          "description": {
            "en": "µg/ml",
            "de": "µg/ml"
          }
        }
      ]
    },
    {
      "label": "tissue_type",
      "mandatory": true,
      "data_type": "ENUM",
      "display_name": {
        "en": "Sample type",
        "de": "Probentyp"
      },
      "description": {
        "en": "Type of tissue sample.",
        "de": "Typ der Gewebeprobe."
      },
      "block": "tissue",
      "allowed_values": [
        {
          "label": "tissue_fixed",
          "display_name": {
            "en": "Tissue fixed",
            "de": "Gewebe fixiert"
          },
          "description": {
            "en": "Fixed tissue sample.",
            "de": "Fixierte Gewebeprobe."
          }
        },
        {
          "label": "tissue_fresh_frozen",
          "display_name": {
            "en": "Tissue fresh frozen",
            "de": "Gewebe frisch gefroren"
          },
          "description": {
            "en": "Fresh frozen tissue sample.",
            "de": "Frisch gefrorene Gewebeprobe."
          }
        }
      ]
    },
    {
      "label": "tissue_fixation",
      "mandatory": false,
      "data_type": "STRING",
      "display_name": {
        "en": "Fixation",
        "de": "Zusatzstoff"
      },
      "block": "tissue"
    },
    {
      "label": "tissue_slices_per_sample",
      "mandatory": false,
      "data_type": "INTEGER",
      "display_name": {
        "en": "Number of slices per sample",
        "de": "Anzahl der Schnitte pro Probe"
      },
      "description": {
        "en": "For example: 5 slices/sample.",
        "de": "Zum Beispiel: 5 Schnitte/Probe."
      },
      "block": "tissue"
    },
    {
      "label": "tissue_pieces_per_donor",
      "mandatory": false,
      "data_type": "INTEGER",
      "display_name": {
        "en": "Tissue pieces per donor",
        "de": "Gewebest\u00fccke pro Person"
      },
      "description": {
        "en": "For example: 1 piece/donor.",
        "de": "Zum Beispiel: 1 Stück/Person."
      },
      "block": "tissue"
    },
    {
      "label": "tissue_weight",
      "mandatory": false,
      "data_type": "INTEGER",
      "display_name": {
        "en": "Minimal tissue weight (in mg)",
        "de": "Minimales Gewicht der Gewebeprobe (in mg)"
      },
      "description": {
        "en": "",
        "de": ""
      },
      "block": "tissue"
    },
    {
      "label": "other_type",
      "mandatory": true,
      "data_type": "ENUM",
      "display_name": {
        "en": "Sample type",
        "de": "Probentyp"
      },
      "description": {
        "en": "Type of sample.",
        "de": "Typ der Probe."
      },
